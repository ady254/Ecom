<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#fdfbf7"/>
      <stop offset="100%" stop-color="#f3eadc"/>
    </radialGradient>
    <linearGradient id="quranGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#6b1124"/>
      <stop offset="100%" stop-color="#3b0813"/>
    </linearGradient>
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#f3d078"/>
      <stop offset="50%" stop-color="#c99738"/>
      <stop offset="100%" stop-color="#9a6e1a"/>
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="3" dy="10" stdDeviation="8" flood-color="#000" flood-opacity="0.18"/>
    </filter>
  </defs>

  <!-- Background Circle -->
  <circle cx="200" cy="200" r="190" fill="url(#bgGrad)"/>
  <circle cx="200" cy="200" r="185" fill="none" stroke="#e8dcc4" stroke-width="2"/>

  <!-- Velvet Quran Book -->
  <g transform="translate(105, 75)" filter="url(#shadow)">
    <!-- Book Pages Edge -->
    <rect x="30" y="25" width="140" height="210" rx="8" fill="#f8f4eb" stroke="#d5c8b2" stroke-width="2"/>
    <!-- Book Velvet Cover -->
    <rect x="20" y="20" width="145" height="215" rx="8" fill="url(#quranGrad)"/>
    <rect x="25" y="25" width="135" height="205" rx="5" fill="none" stroke="url(#goldGrad)" stroke-width="2.5"/>
    
    <!-- Central Islamic Star/Medallion Calligraphy Motif -->
    <circle cx="92" cy="127" r="34" fill="none" stroke="url(#goldGrad)" stroke-width="2"/>
    <circle cx="92" cy="127" r="28" fill="none" stroke="url(#goldGrad)" stroke-width="1.5" stroke-dasharray="4,2"/>
    <!-- Crescent inside medallion -->
    <path d="M 92 108 A 19 19 0 1 0 111 127 A 15 15 0 1 1 92 108 Z" fill="url(#goldGrad)"/>
    <polygon points="106,112 108,118 114,118 109,122 111,128 106,124 101,128 103,122 98,118 104,118" fill="url(#goldGrad)"/>

    <!-- Ribbon Bookmark -->
    <path d="M 92 235 L 92 270 L 100 262 L 108 270 L 108 235 Z" fill="url(#goldGrad)"/>
  </g>
</svg>
